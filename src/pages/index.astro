<script define:vars={{ projectsList: projects }}>
(function () {
  var toggle = document.getElementById('menuToggle');
  var drawer = document.getElementById('sideDrawer');
  var overlay = document.getElementById('drawerOverlay');
  function closeDrawer() {
    drawer.classList.remove('is-open');
    overlay.classList.remove('is-open');
    toggle.setAttribute('aria-expanded', 'false');
    drawer.setAttribute('aria-hidden', 'true');
  }
  function openDrawer() {
    drawer.classList.add('is-open');
    overlay.classList.add('is-open');
    toggle.setAttribute('aria-expanded', 'true');
    drawer.setAttribute('aria-hidden', 'false');
  }
  toggle.addEventListener('click', function () {
    var expanded = toggle.getAttribute('aria-expanded') === 'true';
    if (expanded) { closeDrawer(); } else { openDrawer(); }
  });
  overlay.addEventListener('click', closeDrawer);
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') { closeDrawer(); }
  });
  Array.prototype.forEach.call(drawer.querySelectorAll('a'), function (a) {
    a.addEventListener('click', closeDrawer);
  });
})();

(function () {
  var PROJECTS = {};
  projectsList.forEach(function (p) { PROJECTS[p.id] = p; });

  var stage = document.getElementById('detailStage');
  var page = document.getElementById('detailPage');
  var body = document.getElementById('detailBody');
  var closeBtn = document.getElementById('detailClose');
  var lastTrigger = null;

  function render(data) {
    var html = '';
    html += '<div class="af-eyebrow"><span class="caps">' + data.eyebrow + '</span><span class="caps">' + data.period + '</span></div>';
    html += '<h2 id="detailHeading">' + data.title + '</h2>';
    html += '<p class="detail-lede">' + data.lede + '</p>';
    data.sections.forEach(function (s) {
      html += '<div class="detail-section"><h3>' + s.h + '</h3><p>' + s.p + '</p></div>';
    });
    html += '<div class="detail-links">';
    if (data.links.github) {
      html += '<a href="' + data.links.github + '" target="_blank" rel="noopener">GitHub ↗</a>';
    } else if (data.links.githubNote) {
      html += '<span class="muted">' + data.links.githubNote + '</span>';
    }
    html += '</div>';
    body.innerHTML = html;
  }

  function openDetail(id, trigger) {
    var data = PROJECTS[id];
    if (!data) { return; }
    lastTrigger = trigger || null;
    render(data);
    stage.classList.remove('is-closing');
    stage.setAttribute('aria-hidden', 'false');
    body.scrollTop = 0;
    requestAnimationFrame(function () {
      stage.classList.add('is-open');
    });
    document.body.style.overflow = 'hidden';
    closeBtn.focus();
  }

  function closeDetail() {
    if (!stage.classList.contains('is-open')) { return; }
    stage.classList.add('is-closing');
    stage.classList.remove('is-open');
    document.body.style.overflow = '';
    window.setTimeout(function () {
      stage.classList.remove('is-closing');
      stage.setAttribute('aria-hidden', 'true');
      if (lastTrigger) { lastTrigger.focus(); }
    }, 400);
  }

  Array.prototype.forEach.call(document.querySelectorAll('.detail-trigger'), function (btn) {
    btn.addEventListener('click', function () {
      openDetail(btn.getAttribute('data-project'), btn);
    });
  });
  closeBtn.addEventListener('click', closeDetail);
  stage.addEventListener('click', function (e) {
    if (e.target === stage) { closeDetail(); }
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') { closeDetail(); }
  });
})();

(function () {
  // 방문자 수: counterapi.dev(회원가입 없이 쓸 수 있는 카운터 API)로 실측.
  // 전체 누적 카운터 하나와, 날짜별 네임스페이스(YYYY-MM-DD)로 "오늘" 카운터를 분리해서 집계한다.
  var NAMESPACE = 'dohoasen-github-io';
  var totalEl = document.getElementById('visitorTotal');
  var todayEl = document.getElementById('visitorToday');
  if (!totalEl || !todayEl) { return; }

  function formatNumber(n) {
    return typeof n === 'number' ? n.toLocaleString('en-US') : '—';
  }

  function todayKey() {
    var kst = new Date(Date.now() + 9 * 60 * 60 * 1000);
    var mm = String(kst.getUTCMonth() + 1).padStart(2, '0');
    var dd = String(kst.getUTCDate()).padStart(2, '0');
    return 'day-' + kst.getUTCFullYear() + '-' + mm + '-' + dd;
  }

  function requestCount(key) {
    return fetch('https://api.counterapi.dev/v1/' + NAMESPACE + '/' + key + '/up')
      .then(function (res) {
        if (!res.ok) { throw new Error('counterapi ' + res.status); }
        return res.json();
      });
  }

  function bump(key, el) {
    requestCount(key)
      .catch(function () {
        // counterapi.dev가 가끔 일시적으로 오류를 내서 한 번만 재시도한다.
        return new Promise(function (resolve, reject) {
          window.setTimeout(function () {
            requestCount(key).then(resolve).catch(reject);
          }, 800);
        });
      })
      .then(function (data) { el.textContent = formatNumber(data.count); })
      .catch(function () { el.textContent = '—'; });
  }

  bump('total', totalEl);
  bump(todayKey(), todayEl);
})();

(function () {
  // 헤더 날짜: KST 기준 오늘 날짜를 클라이언트에서 계산해 표시한다.
  var dateEl = document.getElementById('dateTag');
  if (!dateEl) { return; }
  var kst = new Date(Date.now() + 9 * 60 * 60 * 1000);
  var pad = function (n) { return String(n).padStart(2, '0'); };
  dateEl.textContent = kst.getUTCFullYear() + '. ' + pad(kst.getUTCMonth() + 1) + '. ' + pad(kst.getUTCDate());
})();
</script>
