---
import Layout from '../layouts/Layout.astro';
import velogPosts from '../data/velog-posts.json';
import projects from '../data/projects.json';
import githubStats from '../data/github-stats.json';

function formatDate(iso: string) {
  return iso.replaceAll('-', '.');
}

function formatUpdatedAt(iso: string) {
  const d = new Date(iso);
  const kst = new Date(d.getTime() + 9 * 60 * 60 * 1000);
  const pad = (n: number) => String(n).padStart(2, '0');
  return `${kst.getUTCFullYear()}.${pad(kst.getUTCMonth() + 1)}.${pad(kst.getUTCDate())} ${pad(kst.getUTCHours())}:${pad(kst.getUTCMinutes())}`;
}

const leadPost = velogPosts.find((p) => p.isLead) ?? velogPosts[0];
const secondaryPosts = velogPosts.filter((p) => p !== leadPost);

const relatedProjectId =
  leadPost?.relatedProjectId ?? velogPosts.find((p) => p.relatedProjectId)?.relatedProjectId;
const issueProject =
  projects.find((p) => p.id === relatedProjectId) ??
  projects.find((p) => p.featured) ??
  projects[0];
const issueProjectBlurb = issueProject.lede.split('.')[0].trim();
