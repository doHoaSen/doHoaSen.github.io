---
import Layout from '../layouts/Layout.astro';
import projects from '../data/projects.json';
---

<Layout title="doHoaSen.dev / Projects" description="주요 프로젝트 7개를 전부 소개하는 아카이브 페이지.">
  <header class="archive-header">
    <div class="wrap archive-header-row">
      <a class="archive-back" href="/">← doHoaSen</a>
      <span class="caps">Projects Archive</span>
    </div>
    <hr class="rule-double" />
  </header>

  <section class="archive-intro">
    <div class="wrap">
      <h1 class="archive-title">Every Project</h1>
      <p class="archive-lede">홈페이지에는 5개만 골라 실었지만, 여기서는 {projects.length}개 전부를 처음부터 끝까지 볼 수 있어요.</p>
    </div>
  </section>

  <hr class="rule" />

  <section class="archive-list">
    <div class="wrap">
      {projects.map((p, i) => (
        <article class="article-feature is-collapsible" id={`archive-${p.id}`}>
          <button class="af-toggle" type="button" aria-expanded="false" aria-controls={`archive-body-${p.id}`}>
            <span class="af-num">{String(i + 1).padStart(2, '0')}</span>
            <h2 class="af-title">{p.title}</h2>
            <div class="af-eyebrow">
              <span class="caps">{p.eyebrow}</span>
            </div>
            <span class="af-toggle-period caps">{p.period}</span>
            <span class="af-chevron" aria-hidden="true"></span>
          </button>
          {p.sections.some((s) => s.stats && s.stats.length > 0) && (
            <div class="stat-tags af-preview-tags">
              {p.sections.flatMap((s) => s.stats || []).map((t: string) => <span class="stat-tag">{t}</span>)}
            </div>
          )}
          <div class="af-body" id={`archive-body-${p.id}`} hidden>
            <div class="af-meta">
              <blockquote class="af-clip">
                <span class="quote-mark">&ldquo;</span>
                <p>{p.lede}</p>
              </blockquote>
              <dl>
                <dt>Stack</dt>
                <dd>{p.stack?.join(' · ')}</dd>
                <dt>Link</dt>
                <dd>
                  {p.links.github ? (
                    <a href={p.links.github} target="_blank" rel="noopener">GitHub ↗</a>
                  ) : (
                    p.links.githubNote
                  )}
                </dd>
              </dl>
            </div>
            <div class="af-content">
              {p.sections.map((s) => (
                <div class="detail-section">
                  <h3>{s.h}</h3>
                  {s.why ? (
                    <>
                      <p class="whr">{s.why}</p>
                      <p class="whr">{s.how}</p>
                      <p class="whr">{s.result}</p>
                    </>
                  ) : (
                    <p>{s.p}</p>
                  )}
                </div>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <hr class="rule" />

  <footer class="archive-footer">
    <div class="wrap">
      <a class="archive-back archive-back-ko" href="/">← 홈으로 돌아가기</a>
    </div>
  </footer>
</Layout>

<style>
  .archive-header-row {
    display: flex; align-items: center; justify-content: space-between;
    padding: 1.2rem 0;
  }
  .archive-back {
    font-family: var(--font-script); font-size: 1.3rem; text-decoration: none; color: var(--ink);
  }
  .archive-intro { padding-bottom: 0; }
  .archive-title {
    font-family: var(--font-script); font-weight: 400; font-size: clamp(3rem, 7vw, 4.6rem);
    letter-spacing: 0; margin: 0 0 0.8rem; line-height: 1;
  }
  .archive-lede { color: var(--ink-soft); font-size: 1rem; max-width: 60ch; }
  .archive-list .article-feature:first-of-type { padding-top: 2.6rem; }
  .archive-back-ko { font-family: var(--font-sans); font-weight: 600; }
  .archive-footer { padding: 2.4rem 0 3.6rem; text-align: center; }
  .archive-footer .archive-back { font-size: 1.1rem; }

  .is-collapsible .af-toggle {
    display: flex; align-items: center; gap: 1rem; width: 100%;
    background: none; border: none; padding: 0; margin: 0; cursor: pointer;
    text-align: left; font: inherit; color: inherit;
  }
  .is-collapsible .af-toggle .af-eyebrow { margin-bottom: 0; flex: none; }
  .is-collapsible .af-toggle .af-title { margin: 0; flex: 1; }
  .af-num {
    font-family: var(--font-sans); font-weight: 700; font-size: clamp(1rem, 2vw, 1.3rem);
    color: var(--ink); line-height: 1; flex: none;
  }
  .af-preview-tags { margin: 0.6rem 0 0; padding-left: calc(1.3rem + 1rem); }
  .af-toggle-period { flex: none; white-space: nowrap; color: var(--ink-faint); }
  .af-chevron {
    flex: none; width: 1.6rem; height: 1.6rem; border: 1px solid var(--line);
    border-radius: 50%; position: relative;
  }
  .af-chevron::before, .af-chevron::after {
    content: ""; position: absolute; top: 50%; left: 50%; background: var(--ink);
    transition: transform 0.2s ease;
  }
  .af-chevron::before { width: 0.7rem; height: 1.5px; transform: translate(-50%, -50%); }
  .af-chevron::after { width: 1.5px; height: 0.7rem; transform: translate(-50%, -50%); }
  .af-toggle[aria-expanded="true"] .af-chevron::after { transform: translate(-50%, -50%) rotate(90deg) scaleY(0); }
  .is-collapsible .af-body { margin-top: 1.4rem; }
  .is-collapsible .af-body[hidden] { display: none; }
</style>

<script>
  Array.prototype.forEach.call(document.querySelectorAll('.af-toggle'), function (btn) {
    btn.addEventListener('click', function () {
      var expanded = btn.getAttribute('aria-expanded') === 'true';
      var body = document.getElementById(btn.getAttribute('aria-controls'));
      btn.setAttribute('aria-expanded', String(!expanded));
      if (body) { body.hidden = expanded; }
    });
  });
</script>
